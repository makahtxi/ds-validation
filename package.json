{
  "name": "ds-validation",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "vitest run",
    "format": "prettier --write .",
    "audit": "node packages/cli/dist/index.js audit",
    "init": "node packages/cli/dist/index.js init",
    "report": "node packages/cli/dist/index.js report"
  },
  "packageManager": "npm@10.9.2",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "^16.2.9",
    "eslint": "^10.4.1",
    "prettier": "^3.3.3",
    "turbo": "^2.3.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.61.0"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.108.1",
    "jsdom": "^29.1.1"
  }
}
